# Copy to .env and adjust. Do NOT commit .env.

# --- PostgreSQL (used by docker-compose and by the Python scripts) ---
POSTGRES_USER=snomed
POSTGRES_PASSWORD=snomed
POSTGRES_DB=snomed_search
POSTGRES_PORT=5432

# DSN consumed by the Python scripts (psycopg)
PG_DSN=postgresql://snomed:snomed@127.0.0.1:5432/snomed_search

# --- SNOMED release path ---
# Point this at the "Snapshot" directory of ANY SNOMED CT RF2 release you have downloaded.
# The ETL globs for the Concept / Description / Language-refset files by name, so a new
# release just works — only change this path. Example (International edition):
#   .../SnomedCT_InternationalRF2_PRODUCTION_<VERSION>/Snapshot
SNOMED_SNAPSHOT_DIR=/path/to/SnomedCT_InternationalRF2_PRODUCTION_<VERSION>/Snapshot

# --- Auto-download from the SNOMED syndication service (MLDS) — optional ---
# Instead of setting SNOMED_SNAPSHOT_DIR by hand, run `make download` to fetch + extract the latest
# International Edition and set SNOMED_SNAPSHOT_DIR for you. The feed is public; downloading the ZIP
# requires your MLDS credentials (an active SNOMED CT Affiliate/Member account).
SNOMED_USER=your-mlds-username
SNOMED_PASSWORD=your-mlds-password
# MLDS_FEED_URL=https://mlds.ihtsdotools.org/api/feed   # override only if you use a national NRC feed
# SNOMED_DOWNLOAD_DIR=data                               # where the release is downloaded/extracted

# --- Embedding model ---
EMBED_MODEL=FremyCompany/BioLORD-2023-M
EMBED_DEVICE=mps          # mps (Apple Silicon) | cuda (NVIDIA) | cpu

# --- Cross-encoder reranker (optional "rerank" toggle; loaded lazily on first use) ---
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- Local LLM (chat, OpenAI-compatible) for query translation + optional rerank ---
# Easiest path: Ollama (see docs/llm-setup.md). Run: scripts/serve-llm.sh (or set your own endpoint).
# gemma3:12b recommended (quality close to a large model); gemma3:4b is faster/lighter but terser.
GEMMA_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma3:12b
